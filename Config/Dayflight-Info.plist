<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Lets the assistant talk to an OpenAI-compatible server on your local network (Ollama, LM Studio). -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Dayflight can use an AI server on your local network if you configure one in Settings.</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>Dayflight deep links</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>dayflight</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
