// Dayflight — single place to configure identifiers and signing.
//
// 1. Set APP_BUNDLE_ID to a reverse-DNS id you own (the widget becomes <id>.widgets and the
//    App Group becomes group.<id>).
// 2. Set DEVELOPMENT_TEAM to your Apple Developer Team ID (or pick a team in Xcode's
//    Signing & Capabilities tab, which overrides this).

APP_BUNDLE_ID = app.dayflight.Dayflight
DEVELOPMENT_TEAM =

MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 1
IPHONEOS_DEPLOYMENT_TARGET = 18.0
SWIFT_VERSION = 5.0
TARGETED_DEVICE_FAMILY = 1
